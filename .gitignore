# Vercel
.vercel/

# Environment - secrets must never be committed.
# The wildcard is deliberate: it catches .env.production, .env.local and any
# ad-hoc copy or backup that a list of named variants would miss.
.env
.env.*
!.env.example

# Dependencies (none today; this is a static site with no build step)
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
